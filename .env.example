# ── General ──────────────────────────────────────────────
ENVIRONMENT=development            # development | test | production
FRONTEND_URL=http://localhost:5173 # used to build links in emails

# ── Database ─────────────────────────────────────────────
# Docker Compose:
DATABASE_URL=postgresql+asyncpg://jobpilot:jobpilot@db:5432/jobpilot
# Without Docker (local quick start):
# DATABASE_URL=sqlite+aiosqlite:///./jobpilot.db

# ── Auth ─────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false                # true in production (HTTPS)

# ── Google OAuth (optional) ──────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# ── Email ────────────────────────────────────────────────
# Without RESEND_API_KEY emails are printed to the API logs.
RESEND_API_KEY=
EMAIL_FROM=JobPilot AI <onboarding@resend.dev>

# ── AI (from Sprint 2) ───────────────────────────────────
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
